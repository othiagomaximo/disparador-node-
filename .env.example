# Porta (Hostinger define automaticamente, deixa 3000 pra dev local)
PORT=3000

# Segredo da sessão (gera com: openssl rand -hex 32)
SESSION_SECRET=troque-isso-por-string-aleatoria-de-64-caracteres

# Login — usuário principal (gera hash com: npm run hash-pwd suaSenha123)
LOGIN_USER=maximo
LOGIN_PASSWORD_HASH=$2a$10$cole-aqui-o-hash-bcrypt-gerado

# Usuários adicionais (até 10). Descomente e preencha quantos quiser.
# LOGIN_USER_2=vendedor1
# LOGIN_PASSWORD_HASH_2=$2a$10$hash-do-vendedor1
# LOGIN_USER_3=vendedor2
# LOGIN_PASSWORD_HASH_3=$2a$10$hash-do-vendedor2

# Meta Cloud API
META_API_VERSION=v22.0

# Token pra Meta validar webhook de status (sent/delivered/read/failed).
# Gera com: openssl rand -hex 16
# Esse mesmo valor vai no campo "Verify Token" do painel de Webhooks da Meta.
WHATSAPP_VERIFY_TOKEN=
